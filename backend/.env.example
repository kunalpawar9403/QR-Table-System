# TableMint Smart QR Dining & POS Configuration
PORT=3000
NODE_ENV=production

# 4-Digit Security PIN for Floor Staff
STAFF_PIN=1234

# 64-char Cryptographic Secret for Staff JWT and Sessions
# (On Render, this is automatically generated securely)
STAFF_SECRET=replace_with_a_secure_random_64_character_hex_secret

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/tablemint?retryWrites=true&w=majority
MONGODB_URI=
